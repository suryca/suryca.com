# Contact form delivery via Resend (https://resend.com). Copy to .env.local for `npm run dev`.
# When RESEND_API_KEY or CONTACT_TO_EMAIL is missing:
#   - in development, submissions are logged to the terminal and the form still reports success
#   - in production, the API returns 503 and the form shows an error
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@suryca.com
# Must be a sender on a domain verified in Resend. "onboarding@resend.dev" works for testing.
CONTACT_FROM_EMAIL="Suryca <hello@suryca.com>"
